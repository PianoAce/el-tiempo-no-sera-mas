---
// Icono de Instagram: trazo fino, sin relleno, mismo lenguaje que las
// flechas del carrusel y del boton "Volver" (stroke-width 1.5,
// currentColor). Uso puntual como marca de un servicio externo real
// (no es iconografia decorativa), reemplaza el link de texto "Instagram"
// en Footer.astro y en /contacto.
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg
  class={className}
  width="20"
  height="20"
  viewBox="0 0 24 24"
  fill="none"
  aria-hidden="true"
>
  <rect x="2.5" y="2.5" width="19" height="19" rx="5" stroke="currentColor" stroke-width="1.5" />
  <circle cx="12" cy="12" r="4.5" stroke="currentColor" stroke-width="1.5" />
  <circle cx="17.4" cy="6.6" r="1" fill="currentColor" />
</svg>
