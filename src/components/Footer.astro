---
import IconInstagram from "./IconInstagram.astro";
import IconYoutube from "./IconYoutube.astro";

const year = new Date().getFullYear();
---

<footer class="border-t border-ink/10">
  <div class="mx-auto max-w-350 px-6 py-16 md:px-10 md:py-24">
    <div class="grid grid-cols-1 gap-12 md:grid-cols-12">
      <div class="md:col-span-8">
        <p class="font-wordmark max-w-[28ch] text-2xl leading-[1.15] text-ink md:text-3xl">
          Colectivo El tiempo no sera mas
        </p>
        <p class="mt-4 font-sans text-sm leading-relaxed text-ink/70 md:whitespace-nowrap">
          Música de cámara viva y puesta en escena interdisciplinar. Bogotá, Colombia.
        </p>
      </div>

      <div class="md:col-span-4">
        <p class="font-sans text-sm text-ink/70">
          <a href="mailto:colectivoeltiemponoseramas@gmail.com" class="hover:text-ink">
            colectivoeltiemponoseramas@gmail.com
          </a>
        </p>
        <div class="mt-3 flex items-center gap-4">
          <a
            href="https://www.instagram.com/eltiempo.no.sera.mas/"
            aria-label="Instagram"
            class="inline-flex text-ink/70 transition-colors hover:text-ink"
            target="_blank"
            rel="noopener noreferrer"
          >
            <IconInstagram />
          </a>
          <a
            href="https://youtube.com/@colectivoeltiemponoseramas"
            aria-label="YouTube"
            class="inline-flex text-ink/70 transition-colors hover:text-ink"
            target="_blank"
            rel="noopener noreferrer"
          >
            <IconYoutube />
          </a>
        </div>
      </div>
    </div>

    <div
      class="mt-16 h-px w-full md:mt-24"
      style="background-color: var(--accent);"
    >
    </div>

    <p class="mt-6 font-sans text-xs uppercase tracking-[0.08em] text-ink/70">
      &copy; {year} Colectivo El tiempo no será más
    </p>
  </div>
</footer>
